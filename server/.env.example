# Copie para ".env" e preencha. No Render, essas variáveis ficam em Environment.

# Obrigatório em produção: um texto longo e aleatório.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Conta de administrador, criada ao iniciar o servidor
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Tutor de IA (Papp). Sem a chave, o tutor fica desligado e o resto do app funciona.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Banco na nuvem (Neon, Render Postgres, Supabase...). Deixe vazio no computador:
# sem ele, o servidor usa um Postgres embutido que grava em server/data/pglite.
DATABASE_URL=

# Opcionais
PORT=5001
KEY_TTL_DAYS=7
AUTO_APPROVE_PSYCHOLOGISTS=false
